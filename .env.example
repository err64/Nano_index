# Veriforge 官网环境变量样例：复制为 .env 并按需修改
# 本地开发
PORT=8080
HOST=127.0.0.1

# 构建与 SEO 的规范域名（上线前必须替换为真实域名）
SITE_URL=https://veriforge.example.com

# 内容后台访问令牌（必填才能启用 /admin）。生成示例：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# 当反向代理（Caddy/Nginx）已终止 TLS 时设为 1，启用 HSTS 与 upgrade-insecure-requests
HTTPS=0
