/* ============================================================
   Veriforge 官网设计系统 · Dark Forge Engineering
   表面四层 + 熔钢单强调色 + 系统字体 + AA 对比度
   ============================================================ */
:root{
  color-scheme:dark;
  --bg:#090d12; --surface-1:#0c1117; --surface-2:#111820; --surface-3:#151e28;
  --line:#26313d; --line-strong:#34404d;
  --text:#eef2f6; --muted:#98a2ae; --subtle:#6f7a87;
  --accent:#ff7a1f; --accent-hi:#ff8c2e; --accent-soft:rgba(255,122,31,.12);
  --steel:linear-gradient(135deg,#f4581c,#ff8c2e 38%,#ffc46a 74%,#ffedcf);
  --info:#8fb3ff; --ok:#7dcc9a; --warn:#e6bb76; --danger:#e58989;
  --info-soft:rgba(143,179,255,.10); --ok-soft:rgba(125,204,154,.10);
  --warn-soft:rgba(230,187,118,.10); --danger-soft:rgba(229,137,137,.10);
  --radius:10px; --radius-sm:8px; --radius-lg:14px;
  --focus:#c5d9ff;
  --sans:system-ui,-apple-system,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
  --mono:ui-monospace,SFMono-Regular,Consolas,"Courier New",monospace;
  --shadow:0 18px 50px rgba(2,6,12,.4);
  --content:min(1120px,92vw);
  --secpad:clamp(64px,9vw,112px);
}
*,*::before,*::after{box-sizing:border-box}
html{background:var(--bg);scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{
  margin:0;background:var(--bg);color:var(--text);
  font:1.06rem/1.65 var(--sans);
  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
}
img,svg{display:block;max-width:100%}
h1,h2,h3,h4,p,ul,ol,dl,dd,figure,blockquote{margin:0}
ul,ol{padding:0;list-style:none}
a{color:var(--accent);text-decoration:none}
a:hover{text-decoration:underline;text-underline-offset:3px}
button{font:inherit;color:inherit;cursor:pointer;background:none;border:0;padding:0}
input,textarea,select{font:inherit}
strong{font-weight:680}
code,kbd{font-family:var(--mono);font-size:.88em}
code{color:#d5dee9;background:#161d26;border:1px solid var(--line);border-radius:5px;padding:.08em .38em}
:focus-visible{outline:3px solid var(--focus);outline-offset:2px;border-radius:4px}
::selection{background:rgba(255,122,31,.32)}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
.skip-link{position:fixed;z-index:200;top:12px;left:12px;transform:translateY(-200%);
  background:#edf3fb;color:#10151a;font-weight:700;border-radius:var(--radius-sm);padding:10px 14px;transition:transform .16s ease}
.skip-link:focus{transform:translateY(0)}
.ico{width:1.25em;height:1.25em;flex:none;fill:currentColor}

/* ---------- 布局原语 ---------- */
.container{width:var(--content);margin-inline:auto}
.section{padding-block:var(--secpad)}
.section-tight{padding-block:calc(var(--secpad)*.62)}
.section + .section{padding-top:0}
.section-head{max-width:56rem;margin-bottom:clamp(28px,4vw,44px)}
.section-head h2{font-size:clamp(1.6rem,3vw,2.1rem);line-height:1.18;letter-spacing:-.015em;font-weight:740}
.section-head p{color:var(--muted);margin-top:12px;max-width:44rem}
.eyebrow{
  display:inline-flex;align-items:center;gap:8px;color:var(--accent);
  font-family:var(--mono);font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;
  margin-bottom:14px;
}
.eyebrow::before{content:"";width:18px;height:1px;background:var(--accent)}
.lede{color:var(--muted);font-size:1.12rem;max-width:44rem}
.grid{display:grid;gap:18px}

/* ---------- 顶部导航 ---------- */
.site-header{
  position:sticky;top:0;z-index:100;
  background:rgba(9,13,18,.86);backdrop-filter:blur(14px);
  border-bottom:1px solid var(--line);
}
.header-in{display:flex;align-items:center;gap:22px;height:68px}
.brand{display:flex;align-items:center;gap:11px;color:var(--text);margin-right:auto}
.brand:hover{text-decoration:none}
.brand .mark{width:34px;height:34px}
.brand-name{font-weight:760;letter-spacing:-.01em;font-size:1.06rem;line-height:1}
.brand-sub{display:block;color:var(--subtle);font-size:.66rem;font-family:var(--mono);letter-spacing:.12em;margin-top:3px}
.site-nav{display:flex;align-items:center;gap:4px}
.site-nav a{
  color:var(--muted);padding:9px 12px;border-radius:var(--radius-sm);
  font-size:.95rem;white-space:nowrap;
}
.site-nav a:hover{color:var(--text);background:var(--surface-2);text-decoration:none}
.site-nav a[aria-current="page"]{color:var(--text);background:var(--surface-2);box-shadow:inset 0 -2px 0 var(--accent)}
.header-cta{margin-left:6px}
.nav-toggle{display:none;width:44px;height:44px;align-items:center;justify-content:center;border:1px solid var(--line);border-radius:var(--radius-sm);color:var(--text)}
.nav-toggle .ico{width:22px;height:22px}
.nav-toggle .ico-close,.nav-toggle[aria-expanded="true"] .ico-menu{display:none}
.nav-toggle[aria-expanded="true"] .ico-close{display:block}

/* ---------- 按钮 ---------- */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:9px;
  min-height:46px;padding:11px 22px;border-radius:var(--radius);
  border:1px solid var(--line-strong);background:var(--surface-2);color:var(--text);
  font-weight:640;font-size:1rem;white-space:nowrap;
  transition:background .18s ease,border-color .18s ease,transform .12s ease;
}
.btn:hover{background:var(--surface-3);border-color:#46576a;text-decoration:none}
.btn:active{transform:translateY(1px)}
.btn-primary{
  background:var(--accent);border-color:var(--accent);color:#160a02;font-weight:720;
}
.btn-primary:hover{background:var(--accent-hi);border-color:var(--accent-hi)}
.btn-sm{min-height:38px;padding:7px 15px;font-size:.92rem}
.btn .ico{width:1.1em;height:1.1em}
.link-more{display:inline-flex;align-items:center;gap:6px;font-weight:640}
.link-more .ico{transition:transform .18s ease}
.link-more:hover .ico{transform:translateX(3px)}

/* ---------- Hero ---------- */
.hero{position:relative;overflow:hidden;border-bottom:1px solid var(--line)}
.hero::before{ /* 熔钢光带（唯一装饰层之一） */
  content:"";position:absolute;inset:auto -10% -55% -10%;height:70%;pointer-events:none;
  background:radial-gradient(58% 90% at 30% 100%,rgba(255,122,31,.14),transparent 68%);
}
.hero-in{
  position:relative;display:grid;grid-template-columns:minmax(0,10fr) minmax(0,11fr);
  gap:clamp(28px,4.5vw,60px);align-items:center;
  padding-block:clamp(56px,7.5vw,96px) clamp(56px,7vw,88px);
}
.hero h1{
  font-size:clamp(2.4rem,5vw,3.55rem);line-height:1.08;letter-spacing:-.02em;font-weight:780;
}
.hero h1 .steel{
  background:var(--steel);-webkit-background-clip:text;background-clip:text;color:transparent;
}
.hero .lede{margin-top:20px}
.hero-ctas{display:flex;flex-wrap:wrap;gap:14px;margin-top:32px}
.hero-note{display:flex;align-items:center;gap:9px;color:var(--subtle);font-size:.86rem;margin-top:18px;font-family:var(--mono)}
.hero-note .ico{color:var(--ok)}

/* 产品截图窗口 */
.window{
  background:var(--surface-1);border:1px solid var(--line-strong);border-radius:var(--radius-lg);
  overflow:hidden;box-shadow:var(--shadow);
}
.window-bar{
  display:flex;align-items:center;gap:8px;height:40px;padding:0 14px;
  border-bottom:1px solid var(--line);background:var(--surface-2);
}
.window-bar i{width:10px;height:10px;border-radius:50%;background:var(--line-strong)}
.window-bar i:first-child{background:#e5674b}
.window-bar span{margin-left:8px;color:var(--subtle);font-family:var(--mono);font-size:.74rem}
.window img{width:100%;height:auto}
.hero-visual .window{transform:rotate(.4deg)}
.hero-caption{display:flex;gap:8px;align-items:center;margin-top:12px;color:var(--subtle);font-size:.84rem}
.hero-caption .ico{color:var(--ok)}

/* ---------- 事实数据条 ---------- */
.stats{display:grid;grid-template-columns:repeat(4,1fr);border-block:1px solid var(--line)}
.stat{padding:26px 22px;border-left:1px solid var(--line)}
.stat:first-child{border-left:0}
.stat-num{font-family:var(--mono);font-size:clamp(1.7rem,3vw,2.2rem);font-weight:700;letter-spacing:-.02em}
.stat-num em{font-style:normal;background:var(--steel);-webkit-background-clip:text;background-clip:text;color:transparent}
.stat-label{color:var(--muted);font-size:.9rem;margin-top:6px}

/* ---------- 卡片与 Bento ---------- */
.card{
  position:relative;background:var(--surface-2);border:1px solid var(--line);
  border-radius:var(--radius);padding:26px;
  transition:transform .2s ease,border-color .2s ease,background .2s ease;
}
.card:hover{transform:translateY(-2px);border-color:var(--line-strong);background:var(--surface-3)}
.card h3{font-size:1.13rem;font-weight:700;letter-spacing:-.01em}
.card p{color:var(--muted);font-size:.97rem;margin-top:10px}
.card-ico{
  width:44px;height:44px;border-radius:var(--radius-sm);display:grid;place-items:center;
  background:var(--accent-soft);color:var(--accent);margin-bottom:16px;
}
.card-ico .ico{width:22px;height:22px}
.card-link{margin-top:16px}
.bento{display:grid;grid-template-columns:repeat(6,1fr);gap:18px}
.bento .span-3{grid-column:span 3}
.bento .span-2{grid-column:span 2}
.bento .span-4{grid-column:span 4}
.card-flush{display:flex;flex-direction:column;justify-content:space-between}

/* ---------- 验证阶梯 ---------- */
.ladder-wrap{
  background:var(--surface-1);border:1px solid var(--line);border-radius:var(--radius-lg);
  padding:clamp(26px,4vw,48px);
}
.ladder{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;counter-reset:rung}
.rung{
  position:relative;background:var(--surface-2);border:1px solid var(--line);
  border-radius:var(--radius);padding:18px 16px 20px;counter-increment:rung;
}
.rung::before{
  content:counter(rung,decimal-leading-zero);
  font-family:var(--mono);font-size:.72rem;color:var(--accent);letter-spacing:.1em;
}
.rung h3{font-size:1rem;margin-top:8px;font-family:var(--mono);letter-spacing:.02em}
.rung p{color:var(--muted);font-size:.86rem;margin-top:8px;line-height:1.55}
.rung-hot{border-color:rgba(255,122,31,.45);background:linear-gradient(180deg,rgba(255,122,31,.08),var(--surface-2) 60%)}
.rung-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}
.rung-arrow{position:absolute;right:-13px;top:50%;transform:translateY(-50%);color:var(--subtle);z-index:1}

/* ---------- 两栏分述 ---------- */
.split{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,5vw,72px);align-items:center}
.split h2,.split h3{letter-spacing:-.015em}
.split h2{font-size:clamp(1.6rem,3vw,2.05rem);line-height:1.18;font-weight:740}
.split .lede{margin-top:14px;font-size:1.04rem}
.checklist{margin-top:24px;display:grid;gap:14px}
.checklist li{display:flex;gap:12px;align-items:flex-start;color:var(--text)}
.checklist .ico{color:var(--ok);margin-top:3px}
.checklist b{font-weight:660}
.checklist span{color:var(--muted);font-size:.95rem}

/* ---------- 生态 Logo 墙 ---------- */
.logowall{
  display:grid;grid-template-columns:repeat(4,1fr);
  gap:1px;background:var(--line);border:1px solid var(--line);border-radius:var(--radius-lg);overflow:hidden;
}
.logowall li{background:var(--surface-1);display:flex;align-items:center;justify-content:center;padding:26px 12px}
.logowall svg{height:26px;width:auto;fill:#c8d2dc;opacity:.82;transition:opacity .18s ease,fill .18s ease}
.logowall li:hover svg{opacity:1;fill:#eef2f6}

/* ---------- 新闻 ---------- */
.newslist{display:grid;gap:14px}
.newsitem{
  display:grid;grid-template-columns:150px 1fr auto;gap:20px;align-items:baseline;
  padding:22px 24px;background:var(--surface-2);border:1px solid var(--line);border-radius:var(--radius);
  transition:border-color .2s ease,transform .2s ease;
}
.newsitem:hover{border-color:var(--line-strong);transform:translateY(-2px)}
.newsitem time{color:var(--subtle);font-family:var(--mono);font-size:.85rem}
.newsitem h3{font-size:1.1rem;font-weight:680}
.newsitem h3 a{color:var(--text)}
.newsitem h3 a:hover{color:var(--accent);text-decoration:none}
.newsitem p{color:var(--muted);font-size:.94rem;margin-top:8px}
.news-feat{
  background:linear-gradient(135deg,rgba(255,122,31,.10),var(--surface-2) 55%);
  border-color:rgba(255,122,31,.35);
}
.news-feat:hover{border-color:rgba(255,122,31,.55)}

/* ---------- 徽章 ---------- */
.chip{
  display:inline-flex;align-items:center;gap:6px;border-radius:999px;
  padding:3px 11px;font-size:.78rem;font-weight:640;letter-spacing:.02em;
  background:var(--surface-3);border:1px solid var(--line);color:var(--muted);white-space:nowrap;
}
.chip-accent{background:var(--accent-soft);border-color:rgba(255,122,31,.4);color:var(--accent-hi)}
.chip-ok{background:var(--ok-soft);border-color:rgba(125,204,154,.35);color:var(--ok)}
.chip-info{background:var(--info-soft);border-color:rgba(143,179,255,.35);color:var(--info)}
.chip-warn{background:var(--warn-soft);border-color:rgba(230,187,118,.35);color:var(--warn)}
.chip-danger{background:var(--danger-soft);border-color:rgba(229,137,137,.35);color:var(--danger)}

/* ---------- 案例卡片 ---------- */
.casegrid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
.case{display:flex;flex-direction:column;gap:14px}
.case-metrics{display:flex;flex-wrap:wrap;gap:8px;margin-top:auto;padding-top:6px}
.metric{
  font-family:var(--mono);font-size:.8rem;color:var(--text);
  background:var(--surface-1);border:1px solid var(--line);border-radius:6px;padding:4px 10px;
}
.evidence{
  background:#0b1016;border:1px solid var(--line);border-radius:var(--radius-sm);
  padding:14px 16px;font-family:var(--mono);font-size:.8rem;color:#9fb3c8;line-height:1.6;
  overflow-x:auto;
}
.evidence b{color:var(--ok);font-weight:600}

/* ---------- 时间线 ---------- */
.timeline{position:relative;max-width:46rem}
.timeline::before{content:"";position:absolute;left:7px;top:6px;bottom:6px;width:1px;background:var(--line-strong)}
.titem{position:relative;padding:0 0 34px 34px}
.titem:last-child{padding-bottom:0}
.titem::before{
  content:"";position:absolute;left:0;top:7px;width:15px;height:15px;border-radius:50%;
  background:var(--bg);border:2px solid var(--accent);
}
.titem time{font-family:var(--mono);color:var(--accent);font-size:.86rem}
.titem h3{font-size:1.1rem;font-weight:690;margin-top:4px}
.titem p{color:var(--muted);font-size:.96rem;margin-top:6px;max-width:38rem}

/* ---------- 对照表 ---------- */
.cmp{width:100%;border-collapse:collapse;font-size:.97rem}
.cmp th,.cmp td{text-align:left;padding:15px 16px;vertical-align:top}
.cmp thead th{
  font-size:.8rem;font-family:var(--mono);letter-spacing:.1em;text-transform:uppercase;
  color:var(--subtle);border-bottom:1px solid var(--line-strong);
}
.cmp tbody th{font-weight:640;color:var(--text);width:22%}
.cmp tbody tr{border-bottom:1px solid var(--line)}
.cmp tbody tr:last-child{border-bottom:0}
.cmp td{color:var(--muted)}
.cmp td.us{color:var(--text)}
.cmp .ico-ok{color:var(--ok)} .cmp .ico-no{color:var(--subtle)}
.cmp td .ico{width:1.1em;height:1.1em;vertical-align:-.18em}

/* ---------- 手风琴（FAQ） ---------- */
.acc{border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;background:var(--surface-2)}
.acc-item + .acc-item{border-top:1px solid var(--line)}
.acc-btn{
  width:100%;display:flex;align-items:center;gap:14px;justify-content:space-between;
  padding:19px 22px;text-align:left;font-weight:650;font-size:1.02rem;color:var(--text);
}
.acc-btn:hover{background:var(--surface-3)}
.acc-btn .ico{flex:none;color:var(--accent);transition:transform .2s ease}
.acc-btn[aria-expanded="true"] .ico{transform:rotate(45deg)}
.acc-panel{display:none;padding:0 22px 20px;color:var(--muted);font-size:.98rem;max-width:52rem}
.acc-panel.open{display:block}

/* ---------- 选项卡 ---------- */
.tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px}
.tabs [role="tab"]{
  padding:9px 16px;border-radius:999px;border:1px solid var(--line);
  color:var(--muted);font-size:.92rem;background:var(--surface-2);
}
.tabs [role="tab"][aria-selected="true"]{color:#160a02;background:var(--accent);border-color:var(--accent);font-weight:680}
.tabs [role="tabpanel"][hidden]{display:none}
.tabs [role="tabpanel"]{animation:fadein .3s ease}

/* ---------- 代码块 ---------- */
.codeblock{background:#0b1016;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}
.codeblock-head{
  display:flex;align-items:center;gap:10px;padding:10px 16px;
  border-bottom:1px solid var(--line);background:var(--surface-2);
  color:var(--subtle);font-family:var(--mono);font-size:.78rem;
}
.codeblock pre{margin:0;padding:16px 18px;overflow-x:auto;font-family:var(--mono);font-size:.86rem;line-height:1.7;color:#c9d6e2}
.codeblock .prompt{color:var(--subtle);user-select:none}
.codeblock .cmd{color:#ffd9a8}
.codeblock .cmt{color:var(--subtle)}
.copy-btn{margin-left:auto;display:inline-flex;align-items:center;gap:6px;color:var(--subtle);font-size:.76rem;padding:4px 8px;border-radius:6px}
.copy-btn:hover{color:var(--text);background:var(--surface-3)}

/* ---------- 步骤卡 ---------- */
.steps{counter-reset:step;display:grid;gap:16px}
.step{
  counter-increment:step;position:relative;background:var(--surface-2);
  border:1px solid var(--line);border-radius:var(--radius);padding:22px 24px 22px 64px;
}
.step::before{
  content:counter(step,decimal-leading-zero);position:absolute;left:18px;top:22px;
  font-family:var(--mono);font-size:.82rem;color:var(--accent);
  border:1px solid rgba(255,122,31,.4);border-radius:6px;padding:3px 7px;background:var(--accent-soft);
}
.step h3{font-size:1.06rem;font-weight:690}
.step p{color:var(--muted);font-size:.94rem;margin-top:6px}
.step .codeblock{margin-top:14px}

/* ---------- 表单 ---------- */
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.field{display:flex;flex-direction:column;gap:8px}
.field-full{grid-column:1/-1}
.field label{font-weight:640;font-size:.94rem}
.field .req{color:var(--accent)}
.field input,.field textarea,.field select{
  background:var(--surface-1);border:1px solid var(--line-strong);border-radius:var(--radius-sm);
  color:var(--text);padding:12px 14px;min-height:46px;
}
.field textarea{min-height:130px;resize:vertical}
.field input::placeholder,.field textarea::placeholder{color:var(--subtle)}
.field input:focus-visible,.field textarea:focus-visible{outline:3px solid var(--focus);outline-offset:1px}
.field .hint{color:var(--subtle);font-size:.82rem}
.field .err{color:var(--danger);font-size:.85rem;display:none}
.field.invalid input,.field.invalid textarea{border-color:var(--danger)}
.field.invalid .err{display:block}
.form-status{margin-top:16px;font-size:.94rem;display:none;align-items:center;gap:8px}
.form-status.ok{display:flex;color:var(--ok)}
.form-status.fail{display:flex;color:var(--danger)}

/* ---------- CTA 横幅 ---------- */
.ctaband{
  position:relative;overflow:hidden;border:1px solid rgba(255,122,31,.4);border-radius:var(--radius-lg);
  background:
    radial-gradient(70% 130% at 85% 20%,rgba(255,122,31,.16),transparent 60%),
    radial-gradient(50% 110% at 8% 90%,rgba(255,122,31,.10),transparent 55%),
    var(--surface-2);
  padding:clamp(36px,5vw,60px);
  display:flex;align-items:center;justify-content:space-between;gap:28px;flex-wrap:wrap;
}
.ctaband h2{font-size:clamp(1.5rem,2.8vw,1.95rem);font-weight:760;letter-spacing:-.015em}
.ctaband p{color:var(--muted);margin-top:8px;max-width:34rem}

/* ---------- 页脚 ---------- */
.site-footer{border-top:1px solid var(--line);background:var(--surface-1);margin-top:clamp(40px,5vw,72px)}
.foot-grid{display:grid;grid-template-columns:2.2fr 1fr 1fr 1fr;gap:36px;padding:52px 0 40px}
.foot-brand p{color:var(--muted);font-size:.92rem;margin-top:14px;max-width:22rem}
.foot-col h3{font-size:.82rem;font-family:var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--subtle);margin-bottom:14px}
.foot-col ul{display:grid;gap:9px}
.foot-col a{color:var(--muted);font-size:.94rem}
.foot-col a:hover{color:var(--text)}
.foot-meta{
  display:flex;flex-wrap:wrap;gap:8px 22px;align-items:center;justify-content:space-between;
  border-top:1px solid var(--line);padding:20px 0 26px;color:var(--subtle);font-size:.86rem;
}
.foot-meta a{color:var(--subtle)}

/* ---------- 页面头（内页 Hero） ---------- */
.pagehero{border-bottom:1px solid var(--line);position:relative;overflow:hidden}
.pagehero::before{
  content:"";position:absolute;inset:auto -10% -80% 40%;height:90%;pointer-events:none;
  background:radial-gradient(50% 80% at 60% 100%,rgba(255,122,31,.12),transparent 65%);
}
.pagehero-in{position:relative;padding:clamp(52px,7vw,84px) 0 clamp(40px,5vw,60px)}
.pagehero h1{font-size:clamp(2.1rem,4.2vw,3rem);line-height:1.1;letter-spacing:-.02em;font-weight:770;max-width:20em}
.pagehero .lede{margin-top:16px}
.crumbs{display:flex;gap:8px;align-items:center;color:var(--subtle);font-size:.85rem;font-family:var(--mono);margin-bottom:18px}
.crumbs a{color:var(--subtle)} .crumbs a:hover{color:var(--text)}
.crumbs .ico{width:.9em;height:.9em}

/* ---------- 404 ---------- */
.notfound{min-height:70vh;display:grid;place-items:center;text-align:center}
.notfound .code{font-family:var(--mono);font-size:clamp(4rem,12vw,7rem);font-weight:700;letter-spacing:-.04em;
  background:var(--steel);-webkit-background-clip:text;background-clip:text;color:transparent;line-height:1}
.notfound p{color:var(--muted);margin:16px 0 28px}

/* ---------- 显现动画（仅在 JS 可用时启用，无 JS 内容始终可见） ---------- */
@media (prefers-reduced-motion:no-preference){
  .js .reveal{opacity:0;transform:translateY(16px);transition:opacity .55s ease,transform .55s ease}
  .js .reveal.in{opacity:1;transform:none}
  @keyframes fadein{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none!important;transition:none!important}
}

/* ---------- 工具类 ---------- */
.mt-0{margin-top:0}
.mt-10{margin-top:10px}
.mt-14{margin-top:14px}
.mt-20{margin-top:20px}
.mt-26{margin-top:26px}
.table-scroll{overflow-x:auto}
.chip + h3{margin-top:14px}
.card-hot{border-color:rgba(255,122,31,.45)}
.card-hot:hover{border-color:rgba(255,122,31,.6)}
.form-note{color:var(--subtle);font-size:.85rem;margin-top:12px}

/* ---------- 响应式 ---------- */
@media (max-width:1024px){
  .bento{grid-template-columns:repeat(2,1fr)}
  .bento .span-3,.bento .span-2,.bento .span-4{grid-column:span 1}
  .bento .lead-card{grid-column:span 2}
}
@media (max-width:960px){
  .nav-toggle{display:inline-flex}
  .site-nav{
    position:fixed;inset:68px 0 auto 0;z-index:99;display:none;
    flex-direction:column;align-items:stretch;gap:2px;padding:14px 4vw 20px;
    background:var(--surface-1);border-bottom:1px solid var(--line-strong);
    box-shadow:var(--shadow);
  }
  .site-nav.open{display:flex}
  .site-nav a{padding:13px 12px;font-size:1.02rem}
  .site-nav .nav-cta-li{margin-top:10px}
  .header-cta{display:none}
  .hero-in{grid-template-columns:1fr}
  .hero-visual{order:-1}  /* 移动端先看见产品 */
  .split{grid-template-columns:1fr;gap:26px}
  .stats{grid-template-columns:repeat(2,1fr)}
  .stat:nth-child(3){border-left:0}
  .stat:nth-child(n+3){border-top:1px solid var(--line)}
  .ladder{grid-template-columns:1fr 1fr}
  .rung-arrow{display:none}
  .casegrid{grid-template-columns:1fr}
  .foot-grid{grid-template-columns:1fr 1fr}
}
@media (max-width:640px){
  body{font-size:1rem}
  .logowall{grid-template-columns:repeat(2,1fr)}
  .newsitem{grid-template-columns:1fr;gap:8px}
  .form-grid{grid-template-columns:1fr}
  .ladder{grid-template-columns:1fr}
  .cmp thead{display:none}
  .cmp tbody th,.cmp td{display:block;width:100%;padding:8px 16px}
  .cmp tbody tr{border-bottom:1px solid var(--line);padding:8px 0}
  .cmp tbody tr:last-child{border:0}
  .foot-grid{grid-template-columns:1fr;gap:28px}
  .stats{grid-template-columns:1fr 1fr}
  .hero-ctas .btn{flex:1 1 auto}
}

.ctas-center{justify-content:center}
.split-top{align-items:start}
.admin-ctaband{margin-top:26px;padding:26px 30px}
